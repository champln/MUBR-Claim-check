
# ─── ลายเซ็นไฟล์ผู้ป่วยใน AIPN/CIPN ───────────────────────────────────────────
# ไฟล์ผู้ป่วยในเซ็นด้วย HMAC ที่ต้องใช้คีย์ของโรงพยาบาลจากระบบ AIPN ของ สกส.
# ใส่คีย์จริงใน backend/.env (ไฟล์นั้นไม่ขึ้น git) — ห้ามใส่ที่นี่
AIPN_HMAC_KEY=
AIPN_HMAC_ALGO=md5          # md5 | sha1 | sha256
AIPN_HMAC_KEY_FORM=text     # text | hex | upper | lower
AIPN_HMAC_SCOPE=head        # head | head_rstrip | cipn
AIPN_HMAC_MODE=hmac         # hmac | key_prefix | key_suffix
AIPN_HMAC_ATTR=HMAC
